{
  "name": "ratinho-fiscal",
  "displayName": "Ratinho Fiscal",
  "description": "Um ratinho que cobra quando você cola código em vez de digitar",
  "version": "0.0.1",
  "publisher": "s3vla",
  "repository": {
    "type": "git",
    "url": "https://github.com/s3vla/ratinho-fiscal"
  },
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ratinho",
          "title": "Ratinho Fiscal",
          "icon": "media/ratinho.svg"
        }
      ]
    },
    "views": {
      "ratinho": [
        {
          "type": "webview",
          "id": "ratinho.painel",
          "name": "Chef",
          "icon": "media/ratinho.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ratinho-fiscal.colar",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "editorTextFocus"
      },
      {
        "command": "ratinho-fiscal.copiar",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "editorTextFocus"
      },
      {
        "command": "ratinho-fiscal.recortar",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Ratinho Fiscal",
      "properties": {
        "ratinhoFiscal.linhasMinimas": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "A partir de quantas linhas coladas o ratinho reclama."
        },
        "ratinhoFiscal.metaPomodoroMinutos": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "maximum": 120,
          "description": "Minutos codando sem colar pra ganhar um troféu."
        },
        "ratinhoFiscal.pausaSemDigitarMinutos": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "Depois de quantos minutos sem digitar o pomodoro pausa sozinho."
        },
        "ratinhoFiscal.tomatesVoando": {
          "type": "boolean",
          "default": true,
          "description": "O ratinho joga tomates no painel quando você cola."
        },
        "ratinhoFiscal.manchasNoCodigo": {
          "type": "boolean",
          "default": true,
          "description": "Deixa as linhas coladas manchadas de tomate até você explicar."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
