{
  "name": "ratinho-fiscal",
  "displayName": "Ratinho Fiscal",
  "description": "Um ratinho que cobra quando você cola código em vez de digitar",
  "version": "0.0.1",
  "publisher": "s3vla",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ratinho",
          "title": "Ratinho Fiscal",
          "icon": "media/ratinho.svg"
        }
      ]
    },
    "views": {
      "ratinho": [
        {
          "type": "webview",
          "id": "ratinho.painel",
          "name": "Chef",
          "icon": "media/ratinho.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ratinho-fiscal.colar",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "editorTextFocus"
      },
      {
        "command": "ratinho-fiscal.copiar",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "editorTextFocus"
      },
      {
        "command": "ratinho-fiscal.recortar",
        "key": "ctrl+x",
        "mac": "cmd+x",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.138.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
